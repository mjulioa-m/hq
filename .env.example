# =============================================================================
# HQ — producción / docker-compose
# Copia a .env en el servidor. Nunca subas secretos.
# =============================================================================

# URL pública (sin barra final)
APP_URL=https://hq.tu-dominio.com

# Postgres (compose reescribe DATABASE_URL para el servicio web)
POSTGRES_PASSWORD=cambia-esta-clave
DATABASE_URL=postgresql://hq:cambia-esta-clave@hq-db:5432/hq

# Auth.js — openssl rand -base64 32
AUTH_SECRET=
# AUTH_URL=https://hq.tu-dominio.com

# Usuario inicial (scripts/seed.mjs es idempotente)
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Tu nombre

# Zona horaria de fechas y del reloj
TZ=America/Bogota

# Clave para el MCP. openssl rand -hex 24. No la subas.
HQ_API_TOKEN=

# Red Docker externa que ya usa el proxy. Obligatoria para docker compose.
PROXY_NETWORK=nombre-de-tu-red-docker
