# Copia a .env.local para desarrollo local.

# Postgres embebido: npm run db:embedded  (puerto 54330)
# o solo la base: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgresql://hq:hq@127.0.0.1:54330/hq

APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-secret-change-me-use-openssl-rand

ADMIN_EMAIL=admin@hq.local
# Clave solo para esta máquina. No la uses en un servidor.
ADMIN_PASSWORD=hq-local-dev
ADMIN_NAME=Admin

TZ=America/Bogota

# MCP local. No apuntes esto a un servidor público con una clave real dentro del repo.
HQ_URL=http://127.0.0.1:3000
HQ_API_TOKEN=
